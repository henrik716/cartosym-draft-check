{
  "stylingRules": [
    {
      "$comment": "03-feature-pass with wider strokes, so that the difference from 04 shows:\neach feature is drawn with the black stroke, then with the white one,\nbefore the next feature is drawn.",
      "selector": {
        "op": "=",
        "args": [
          {
            "property": "kind"
          },
          "road"
        ]
      },
      "symbolizer": {
        "marker": null
      },
      "nestedRules": [
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "sysId": "feature.pass"
              },
              0
            ]
          },
          "symbolizer": {
            "stroke": {
              "color": "black",
              "width": {
                "px": 12.0
              }
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "sysId": "feature.pass"
              },
              1
            ]
          },
          "symbolizer": {
            "stroke": {
              "color": "white",
              "width": {
                "px": 8.0
              }
            }
          }
        }
      ]
    }
  ]
}